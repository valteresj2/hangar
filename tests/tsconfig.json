{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@shared/*": ["../src/shared/*"],
      "@renderer/*": ["../src/renderer/src/*"]
    }
  },
  "include": ["./**/*.ts", "../vitest.config.mts", "../playwright.config.ts", "../src/preload/*.d.ts"]
}
